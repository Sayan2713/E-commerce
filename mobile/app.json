{
  "expo": {
    "name": "ClothStore",
    "slug": "clothstore-mobile",
    "version": "1.0.0",
    "scheme": "clothstore",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F7F2EB",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clothstore.app"
    },
    "android": {
      "package": "com.clothstore.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F2EB"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications",
      ["expo-image-picker", { "photosPermission": "Allow ClothStore to access your photos to set a profile picture." }]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
